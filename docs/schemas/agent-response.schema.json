  "$id": "https://galactic-conquest.invalid/schema/agent-response.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actions": {
      "items": {
        "$ref": "#/$defs/AgentAction"
      },
      "maxItems": 200,
