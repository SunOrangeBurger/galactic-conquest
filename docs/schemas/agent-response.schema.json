              "const": "attack"
            }
          },
          "required": [
            "type",
            "fleet_id",
            "target_planet"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "fleet_id": {
              "type": "string"
            },
            "target_system": {
              "type": "string"
            },
